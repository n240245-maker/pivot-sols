SMTP_HOST=smtp.gmail.com
EMAIL_PROVIDER=smtp
# Free hosted deployment: EMAIL_PROVIDER=brevo and a server-only key.
BREVO_API_KEY=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pivot Sols
OTP_SECRET=replace-with-long-random-secret
FRONTEND_URL=http://localhost:5173
CONTACT_TO_EMAIL=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/pivot_sols
# Optional durable, S3-compatible storage for faculty images and career PDFs.
# Without these, Agent can paste HTTPS URLs, but direct uploads return 503.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
